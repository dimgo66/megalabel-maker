# Auto detect text files and perform LF normalization
* text=auto

# Explicitly declare text files we want to normalize
*.json text
*.js text
*.jsx text
*.ts text
*.tsx text
*.html text
*.css text
*.md text

# Declare files that will always have CRLF line endings on checkout
*.sln text eol=crlf

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
